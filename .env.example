# ---------------------------------------------------------------------------
# Fourth Axis — environment variables
#
# Copy this file to .env.local for development. In production (e.g. Vercel),
# set these in the hosting dashboard. Variables WITHOUT the NEXT_PUBLIC_
# prefix are server-only and are never exposed to the browser.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------

# Canonical production URL (no trailing slash). Used for metadata, sitemap,
# robots.txt, Open Graph URLs and structured data.
NEXT_PUBLIC_SITE_URL=https://fourthaxis.com

# --- Contact form (choose ONE provider; see lib/email.ts) ------------------

# Option A — Resend (recommended): https://resend.com
# Create an API key, verify your sending domain, then set:
RESEND_API_KEY=
# Where inquiries are delivered. Defaults to the address in data/site.ts.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Fourth Axis <inquiries@fourthaxis.com>".
# Until a domain is verified, Resend's onboarding@resend.dev works for tests.
CONTACT_FROM_EMAIL=
# Set to "true" to send the visitor an automated confirmation email.
CONTACT_SEND_CONFIRMATION=false

# Option B — Formspree: https://formspree.io
# Create a form and paste its endpoint URL, e.g. https://formspree.io/f/abcdwxyz
FORMSPREE_ENDPOINT=

# With neither option set, submissions are logged to the server console and
# reported as successful — convenient for local development.

# --- Newsletter (choose ONE provider; see lib/newsletter.ts) ---------------

# Option A — Buttondown: https://buttondown.com  (Settings → API)
BUTTONDOWN_API_KEY=

# Option B — ConvertKit (Kit): https://kit.com  (API key + the form ID to subscribe to)
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Option C — Beehiiv: https://www.beehiiv.com  (API key + publication ID)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Option D — Mailchimp: API key (datacenter suffix included, e.g. ...-us21)
# plus the audience/list ID.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# With none set, signups are logged to the server console and reported as
# successful — convenient for local development.

# --- Analytics (optional, cookie-free; see lib/analytics.tsx) --------------

# Option A — Plausible: your site domain as registered with Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Option B — Fathom: your Fathom site ID.
NEXT_PUBLIC_FATHOM_SITE_ID=

# With neither set, no analytics script is loaded at all.
